{
  "kind": "service",
  "ci": {
    "with": {
      "shellcheck": "with-secrets *.sh scripts/*.sh backups/pg-backup",
      "terraform-dir": "infra",
      "setup": "python3 -m venv .venv && tests/install-lock .venv/bin/pip && (cd edge-gate && npm ci --ignore-scripts)",
      "test": "(cd tests && ../.venv/bin/python -m pytest -q steps) && (cd edge-gate && npx cucumber-js)"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "auth-proofs",
      "integrations / scan"
    ],
    "tags": false
  },
  "hosting": {
    "providers": {
      "google-cloud": {
        "type": "google-cloud",
        "project": "sustenaut",
        "region": "europe-north1",
        "cloud_run": {
          "domain_target": "ghs.googlehosted.com."
        }
      }
    }
  },
  "deploy": {
    "namespace": "auth",
    "host": "auth.sustenaut.eu",
    "workflow": "auth.yml",
    "gate": "DEPLOY_AUTH",
    "providers": [
      {
        "distribution": "pubdeploy",
        "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.5.1/pubdeploy-0.5.1-py3-none-any.whl",
        "sha256": "efbbcc3b1741f7a9296a497a68ad4ab7560fd2a6b5371c4e69c3aa5fba854b70"
      },
      {
        "distribution": "pubsec",
        "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.3.0/pubsec-0.3.0-py3-none-any.whl",
        "sha256": "a9036c741e29098cdd04baf64c7873e0ff1dd6e7bde12e9671a3940370724e18"
      },
      {
        "distribution": "pg-backup",
        "wheel": "https://github.com/Sustenaut/pg-backup/releases/download/v0.4.0/pg_backup-0.4.0-py3-none-any.whl",
        "sha256": "cc03bb75b18a11334f84425e5fa9a7c05a92e578625f32ca4805924b8e6b49ee"
      }
    ],
    "needs": [
      {
        "type": "bitwarden.secret",
        "name": "auth-db-password",
        "secret": {
          "name": "auth-secrets",
          "key": "db-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-admin-password",
        "secret": {
          "name": "auth-secrets",
          "key": "admin-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-config-client-secret",
        "secret": {
          "name": "auth-secrets",
          "key": "config-client-secret"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-issuer-keystore",
        "secret": {
          "name": "auth-secrets",
          "key": "issuer-keystore"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-issuer-keystore-password",
        "secret": {
          "name": "auth-secrets",
          "key": "issuer-keystore-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-review-client-secret",
        "secret": {
          "name": "auth-secrets",
          "key": "review-client-secret"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-smtp-login",
        "secret": {
          "name": "auth-secrets",
          "key": "mailbox-smtp-login"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-smtp-password",
        "secret": {
          "name": "auth-secrets",
          "key": "mailbox-smtp-password"
        }
      },
      {
        "type": "gcp.workload-identity",
        "account": "sustenaut-auth-backup",
        "project": "sustenaut",
        "serviceaccount": "backup",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "bitwarden.adopt",
        "name": "auth-access-hash-key",
        "secret": {
          "name": "auth-secrets",
          "key": "access-hash-key"
        },
        "format": "[0-9a-f]{64}",
        "shape": "hex-32",
        "note": "copied from auth-secrets, as hex-32"
      },
      {
        "type": "pg.database"
      },
      {
        "type": "k8s.secret",
        "name": "auth-wal",
        "keys": [
          "libsodium-key"
        ],
        "after": [
          "pg.database:postgres"
        ]
      },
      {
        "type": "gcp.workload-identity",
        "account": "sustenaut-auth-wal",
        "project": "sustenaut",
        "serviceaccount": "postgres",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "service.health",
        "path": "/realms/team/.well-known/openid-configuration",
        "job": "cronjob/backup"
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
