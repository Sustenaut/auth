{
  "realm": "sustenaut",
  "clients": [
    {
      "clientId": "test-app",
      "name": "Local test app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:SUSTENAUT_TEST_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8099/*"
      ],
      "webOrigins": [
        "http://localhost:8099"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8099/*"
      }
    },
    {
      "clientId": "test-app-2",
      "name": "Second local test app (public, for the single sign-on check)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8098/*"
      ],
      "webOrigins": [
        "http://localhost:8098"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8098/*"
      }
    },
    {
      "clientId": "review-local",
      "name": "The review service run locally (make review)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:SUSTENAUT_TEST_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8001/"
      }
    }
  ]
}
