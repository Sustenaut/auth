{
  "kind": "service",
  "ci": {
    "with": {
      "shellcheck": "with-secrets *.sh scripts/*.sh backups/pg-backup",
      "terraform-dir": "infra",
      "setup": "python3 -m venv .venv && tests/install-lock .venv/bin/pip",
      "test": "cd tests && ../.venv/bin/python -m pytest -q steps"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "auth-proofs",
      "integrations / scan"
    ],
    "tags": false
  },
  "hosting": {
    "providers": {
      "google-cloud": {
        "type": "google-cloud",
        "project": "sustenaut",
        "region": "europe-north1",
        "cloud_run": {
          "domain_target": "ghs.googlehosted.com."
        }
      }
    }
  },
  "deploy": {
    "namespace": "auth",
    "host": "auth.sustenaut.eu",
    "workflow": "auth.yml",
    "gate": "DEPLOY_AUTH",
    "providers": [
      {
        "distribution": "pubdeploy",
        "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.4.1/pubdeploy-0.4.1-py3-none-any.whl",
        "sha256": "c9c9b49b44b771c6f15219c186e3646203381c6a30570c0b2568951d3a53deb0"
      },
      {
        "distribution": "pubsec",
        "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.2.3/pubsec-0.2.3-py3-none-any.whl",
        "sha256": "4a0b9435ff111565265f330fa3a1642b59562d77b5d1806c1bfecfe83e63b106"
      },
      {
        "distribution": "pg-backup",
        "wheel": "https://github.com/Sustenaut/pg-backup/releases/download/v0.3.0/pg_backup-0.3.0-py3-none-any.whl",
        "sha256": "a04868ea3ab8008a673e8c016e4029c9dadd8a899aaf047d50e7021fa8e127b0"
      }
    ],
    "needs": [
      {
        "type": "bitwarden.secret",
        "name": "auth-db-password",
        "secret": {
          "name": "auth-secrets",
          "key": "db-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-admin-password",
        "secret": {
          "name": "auth-secrets",
          "key": "admin-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-config-client-secret",
        "secret": {
          "name": "auth-secrets",
          "key": "config-client-secret"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-issuer-keystore",
        "secret": {
          "name": "auth-secrets",
          "key": "issuer-keystore"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-issuer-keystore-password",
        "secret": {
          "name": "auth-secrets",
          "key": "issuer-keystore-password"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-review-client-secret",
        "secret": {
          "name": "auth-secrets",
          "key": "review-client-secret"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-smtp-login",
        "secret": {
          "name": "auth-secrets",
          "key": "mailbox-smtp-login"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-smtp-password",
        "secret": {
          "name": "auth-secrets",
          "key": "mailbox-smtp-password"
        }
      },
      {
        "type": "gcp.workload-identity",
        "account": "sustenaut-auth-backup",
        "project": "sustenaut",
        "serviceaccount": "backup",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "bitwarden.generated",
        "name": "auth-access-hash-key",
        "shape": "hex-32",
        "secret": {
          "name": "auth-secrets",
          "key": "access-hash-key"
        }
      },
      {
        "type": "pg.database"
      },
      {
        "type": "k8s.secret",
        "name": "auth-wal",
        "keys": [
          "gcs-key.json",
          "libsodium-key"
        ],
        "after": [
          "pg.database:postgres"
        ]
      },
      {
        "type": "service.health",
        "path": "/realms/team/.well-known/openid-configuration",
        "job": "cronjob/backup"
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
